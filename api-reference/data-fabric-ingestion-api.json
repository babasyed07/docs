    "/ingestion/v1/entity/{entityId}": {
      "delete": {
        "tags": [
          "Entity Ingestion"
        ],
        "summary": "Delete Entity",
        "description": "Deletes an Entity in Reva",
        "operationId": "deleteEntity",
        "parameters": [
          {
            "name": "entityTypeId",
            "in": "query",
            "description": "Unique identifier for the entity type.\n\nTo find the `entityTypeId`, follow these steps:\n- From the left menu, navigate to an Application -> Environment -> Policy Store\n- Click on the \"Data\" tab.\n- Here you will see a list of all Entity Types along with their IDs. Copy the ID of the entity type you want to use.",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "abcde-1234"
          },
          {
            "name": "entityId",
            "in": "path",
            "description": "Unique identifier of the entity",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 123
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "BAD.REQUEST",
                  "message": "Entity ID must not be blank",
                  "data": "entityId"
                }
              }
            }
