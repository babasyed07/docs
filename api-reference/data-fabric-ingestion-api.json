      "patch": {
        "tags": [
          "Entity Ingestion"
        ],
        "summary": "Update Entity",
        "description": "Updates specific attributes or parents of an existing entity in Reva without overwriting the full entity",
        "operationId": "updateEntity",
        "parameters": [
          {
            "name": "entityTypeId",
            "in": "query",
            "description": "Unique identifier for the entity type.\n\nTo find the `entityTypeId`, follow these steps:\n- From the left menu, navigate to an Application -> Environment -> Policy Store\n- Click on the \"Data\" tab.\n- Here you will see a list of all Entity Types along with their IDs. Copy the ID of the entity type you want to use.",
