{
  "openapi": "3.0.3",
  "info": {
    "title": "Guardrail Rule Builder API",
    "description": "APIs used by the guardrail rule builder session lifecycle.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.app.reva.ai",
      "description": "Production"
    },
    {
      "url": "https://api.preview.reva.ai",
      "description": "Preview"
    },
    {
      "url": "https://api.dev.reva.ai",
      "description": "Development"
    }
  ],
  "tags": [
    {
      "name": "Guardrail Rule Builder",
      "description": "Manage guardrail rule builder sessions."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/rule/api-init": {
      "post": {
        "tags": [
          "Guardrail Rule Builder"
        ],
        "summary": "Initialize rule builder session",
        "description": "Initializes a rule builder session.",
        "operationId": "initializeRuleBuilderSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SocketInitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SocketInitResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "INTERNAL.SERVER.ERROR",
                  "message": "Some error has occurred, Please contact administrator"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/rule/api-message": {
      "post": {
        "tags": [
          "Guardrail Rule Builder"
        ],
        "summary": "Send rule builder message",
        "description": "Sends a message to the rule builder session and returns the generated response.",
        "operationId": "sendRuleBuilderMessage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SocketMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SocketMessageResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "INTERNAL.SERVER.ERROR",
                  "message": "Some error has occurred, Please contact administrator"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/rule/api-destroy": {
      "post": {
        "tags": [
          "Guardrail Rule Builder"
        ],
        "summary": "Destroy rule builder session",
        "description": "Destroys a rule builder session.",
        "operationId": "destroyRuleBuilderSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SocketMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "INTERNAL.SERVER.ERROR",
                  "message": "Some error has occurred, Please contact administrator"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "string"
          }
        }
      },
      "SocketInitRequest": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      },
      "SocketInitResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "SocketMessageRequest": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      },
      "SocketMessageResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
