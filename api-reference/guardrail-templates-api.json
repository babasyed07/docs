{
  "openapi": "3.0.3",
  "info": {
    "title": "Guardrail Templates API",
    "description": "APIs to create, update, list, and delete guardrail templates used by design-time and runtime guardrails.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.pr06.preview.reva.ai",
      "description": "Preview"
    },
    {
      "url": "https://api.dv06.dev.reva.ai",
      "description": "Development"
    }
  ],
  "tags": [
    {
      "name": "Guardrail Templates",
      "description": "Manage reusable guardrail templates."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/template": {
      "get": {
        "tags": [
          "Guardrail Templates"
        ],
        "summary": "List guardrail templates",
        "description": "Returns guardrail templates. Optional filters include type, category, and AI lifecycle stage.",
        "operationId": "listGuardrailTemplates",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter by template type: DESIGN_TIME or RUN_TIME",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "RUN_TIME",
                "DESIGN_TIME"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter by template category: AI or STANDARD",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "AI",
                "STANDARD",
                "BOTH"
              ]
            }
          },
          {
            "name": "aiStage",
            "in": "query",
            "description": "Filter by AI lifecycle stage: ENTRY, EXIT or BOTH. When ENTRY/EXIT is supplied, BOTH-tagged templates are also returned.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ENTRY",
                "EXIT",
                "BOTH"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateDetailResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "INTERNAL.SERVER.ERROR",
                  "message": "Some error has occurred, Please contact administrator"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Guardrail Templates"
        ],
        "summary": "Create guardrail template",
        "description": "Creates a new guardrail template.",
        "operationId": "createGuardrailTemplate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemplateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "INTERNAL.SERVER.ERROR",
                  "message": "Some error has occurred, Please contact administrator"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
