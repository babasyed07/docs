{
  "openapi": "3.0.1",
  "info": {
    "title": "Access Map API",
    "description": "Refresh access maps for active policy store versions and drafts.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.app.reva.ai",
      "description": "Production"
    },
    {
      "url": "https://api.preview.reva.ai",
      "description": "Preview"
    },
    {
      "url": "https://api.dev.reva.ai",
      "description": "Development"
    }
  ],
  "tags": [
    {
      "name": "Access Map",
      "description": "Refresh and synchronize access maps in Reva."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/application/{applicationName}/policy-store/{policyStoreName}/accessmap": {
      "put": {
        "tags": [
          "Access Map"
        ],
        "summary": "Refresh access map",
        "description": "Refreshes the access map for active policy store versions and drafts.",
        "operationId": "refreshAccessMap",
        "parameters": [
          {
            "name": "applicationName",
            "in": "path",
            "description": "Application name",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "app_01"
          },
          {
            "name": "policyStoreName",
            "in": "path",
            "description": "Policy store name",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Reva Policy store"
          },
          {
            "name": "env",
            "in": "query",
            "description": "Environment name",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Dev"
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevaEntityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "BAD.REQUEST",
                  "message": "Env must not be blank",
                  "data": "entityId"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "RESOURCE.NOT.FOUND",
                  "message": "Invalid Policy store",
                  "data": "abcd-1234"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "INTERNAL.SERVER.ERROR",
                  "message": "Some error has occured, Please contact administrator"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "string"
          }
        }
      },
      "RevaEntityResponse": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "description": "Unique identifier of the entity",
            "example": "12345"
          },
          "entityTypeId": {
            "type": "string",
            "description": "Unique type identifier of the entity",
            "example": "abcde-1234"
          }
        }
      }
    }
  }
}
