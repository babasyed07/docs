                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "key": "INTERNAL.SERVER.ERROR",
                                    "message": "Some error has occured, Please contact administrator"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
       "securitySchemes": {
           "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "schemas": {
      "AuthZENSubject": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Logical entity-type (e.g. \"User\")"
          },
          "id": {
            "type": "string",
            "description": "Entity identifier (e.g. \"alice\")"
          }
        }
      },
      "AuthZENAction": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Action ID (may be schema-qualified)"
          }
        }
      },
      "AuthZENResource": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": { "type": "string" },
          "id": { "type": "string" },
          "properties": {
            "type": "object",
            "additionalProperties": true,
            "description": "Free-form resource attributes"
          }
        },
        "description": "Target resource of the decision"
      },
      "AuthZENRequest": {
        "type": "object",
        "required": ["subject", "action", "resource"],
        "properties": {
          "subject": { "$ref": "#/components/schemas/AuthZENSubject" },
          "action": { "$ref": "#/components/schemas/AuthZENAction" },
          "resource": { "$ref": "#/components/schemas/AuthZENResource" },
          "context": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional contextual attributes"
          }
        }
      },
      "AuthZENResponse": {
        "type": "object",
        "required": ["decision"],
        "properties": {
          "decision": {
            "type": "boolean",
            "description": "true → allow, false → deny"
          }
        }
      },
      "HTTPError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable error message"
          }
        }
      },
            "RevaAttribute": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Name of the attribute.",
                        "example": "color"
                    },
                    "value": {
                        "type": "string",
                        "description": "Value of the attribute.",
                        "example": "blue"
                    }
                },
                "description": "Attribute of a Reva entity, represented as a name-value pair."
            },
            "RevaChild": {
                "type": "object",
                "properties": {
                    "entityId": {
                        "type": "string",
                        "description": "Unique identifier of the child entity.",
                        "example": "child-001"
                    },
                    "entityType": {
                        "type": "string",
                        "description": "Type of the child entity.",
                        "example": "Team"
                    }
                },
                "description": "Child entity related to a Reva entity."
            },
            "RevaEntity": {
                "required": [
                    "entityId"
                ],
                "type": "object",
                "properties": {
                    "entityId": {
                        "type": "string",
                        "description": "Unique identifier of the entity.",
                        "example": "12345"
                    },
                    "attributes": {
                        "uniqueItems": true,
                        "type": "array",
                        "description": "Set of attributes associated with the entity.",
                        "items": {
                            "$ref": "#/components/schemas/RevaAttribute"
                        }
                    },
                    "parents": {
                        "uniqueItems": true,
                        "type": "array",
                        "description": "Set of parent entities related to this entity.",
                        "items": {
                            "$ref": "#/components/schemas/RevaParent"
                        }
                    },
                    "children": {
                        "uniqueItems": true,
                        "type": "array",
                        "description": "Set of child entities related to this entity.",
                        "items": {
                            "$ref": "#/components/schemas/RevaChild"
                        }
                    }
                },
                "description": "DTO representing a Reva entity with attributes, parents, and children."
            },
            "RevaParent": {
                "type": "object",
                "properties": {
                    "entityId": {
                        "type": "string",
                        "description": "Unique identifier of the parent entity.",
                        "example": "parent-001"
                    },
                    "entityType": {
                        "type": "string",
                        "description": "Type of the parent entity.",
                        "example": "Department"
                    }
                },
                "description": "Parent entity related to a Reva entity."
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "data": {
                        "type": "string"
                    }
                }
            },
            "RevaEntityResponse": {
                "type": "object",
                "properties": {
                    "entityId": {
                        "type": "string",
                        "description": "Unique identifier of the entity",
                        "example": "12345"
                    },
                    "entityTypeId": {
                        "type": "string",
                        "description": "Unique type identifier of the entity",
                        "example": "abcde-1234"
                    }
                }
            },
            "AttributeValue": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Name of the attribute to update",
                        "example": "Salary"
                    },
                    "value": {
                        "type": "string",
                        "description": "New value of the attribute",
                        "example": "100000"
                    }
                },
                "description": "Details about an attribute update, used when path is ATTRIBUTE"
            },
            "RelationValue": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier of the related entity",
                        "example": "parent-entity-6789"
                    },
                    "typeId": {
                        "type": "string",
                        "description": "Type identifier of the relation",
                        "example": "type-4567"
                    }
                },
                "description": "Details about a relation update, used when path is PARENT or CHILD"
            },
            "UpdateRevaEntityDto": {
                "required": [
                    "entityId",
                    "op",
                    "path"
                ],
                "type": "object",
                "properties": {
                    "entityId": {
                        "type": "string",
                        "description": "Unique identifier of the entity to be updated",
                        "example": "entity-12345"
                    },
                    "op": {
                        "type": "string",
                        "description": "Supported update operations",
                        "example": "REPLACE",
                        "enum": [
                            "ADD",
                            "REMOVE",
                            "REPLACE"
                        ]
                    },
                    "path": {
                        "type": "string",
                        "description": "Entity path to be updated",
                        "example": "ATTRIBUTE",
                        "enum": [
                            "ATTRIBUTE",
                            "PARENT",
                            "CHILD"
                        ]
                    },
                    "relationValue": {
                        "$ref": "#/components/schemas/RelationValue"
                    },
                    "attributeValue": {
                        "$ref": "#/components/schemas/AttributeValue"
                    }
                },
                "description": "Request object to update an entities' attributes or relationships"
            }
        }
    }
}