    "tags": [
        {
            "name": "Authorization APIs - AuthZEN Complaint",
            "description": "These APIs are used to entities in Reva using the REST protocol. Any invalid records that result in errors should be retried by the caller."
        },
        {
            "name": "Access Map APIs",
            "description": "These APIs are used to manage and synchronize access maps in Reva."
        },
        {
            "name": "Data Ingestion APIs",
            "description": "These APIs are used to manage and synchronize entities in Reva using the REST protocol. Any invalid records that result in errors should be retried by the caller."
