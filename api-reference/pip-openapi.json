    "paths": {
        "/access/v1/evaluation": { 
        "post": {
        "summary": "Evaluate Entity",
        "description": "Used to evaluate a access decision request. Each request contains one subject-action-resource tuple to determine whether access is permitted or denied.",
        "tags": ["Authorization APIs - AuthZEN Complaint"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  { "$ref": "#/components/schemas/AuthZENRequest" },
                  {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/AuthZENRequest" }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mirrored list of decisions",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    { "$ref": "#/components/schemas/AuthZENResponse" },
                    {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AuthZENResponse" }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad input",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPError" }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPError" }
                }
               }
             }
           }
         }
        },
        "/v1/entity/bulk": {
        "post": {
        "tags": [
          "Data Ingestion APIs"
        ],
        "summary": "Create Entities",
        "description": "Creates new entities in bulk in Reva",
        "operationId": "createEntities",
        "parameters": [
          {
            "name": "entityTypeId",
            "in": "query",
            "description": "Unique identifier for the entity type.\n\nTo find the `entityTypeId`, follow these steps:\n- From the left menu, navigate to an Application -> Environment -> Policy Store\n- Click on the \"Data\" tab.\n- Here you will see a list of all Entity Types along with their IDs. Copy the ID of the entity type you want to use.",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "abcde-1234"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RevaEntity"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevaEntityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "BAD.REQUEST",
                  "message": "Entity ID must not be blank",
                  "data": "entityId"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "RESOURCE.NOT.FOUND",
                  "message": "Invalid Entity type ID",
                  "data": "abcd-1234"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "RESOURCE.ALREADY.EXISTS",
                  "message": "Entity already exists for the provided entity type ID and entity ID",
                  "data": "abcd123"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "key": "INTERNAL.SERVER.ERROR",
                  "message": "Some error has occured, Please contact administrator"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
