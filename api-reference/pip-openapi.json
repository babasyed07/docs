        "/v1/application/{applicationName}/policy-store/{policyStoreName}/accessmap": { 
            "put": {
                "tags": [
                    "Access Map APIs"
                ],
                "summary": "Refresh Access Map",
                "description": "This API is used to refresh access map for active policy store version and drafts.",
                "operationId": "refreshAccessMap",
                "parameters": [
                    {
                        "name": "applicationName",
                        "in": "path",
                        "description": "Application name",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "app_01"
                    },
                    {
                        "name": "policyStoreName",
                        "in": "path",
                        "description": "Policy store name",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "Reva Policy store"
                    },
                    {
                        "name": "env",
                        "in": "query",
                        "description": "Environment name",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "Dev"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
